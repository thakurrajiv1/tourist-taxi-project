NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Your business WhatsApp number, country code + number, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000

# --- Find Us section (homepage) ---
# Leave any of these blank and that panel shows a "not connected yet"
# placeholder instead of breaking.

# Your business address, used for the Google Maps embed. No API key
# needed for this basic embed.
NEXT_PUBLIC_BUSINESS_ADDRESS=

# A link to your Google Business Profile (search your business on Google
# Maps, click Share, copy the link). Powers a "Read Reviews on Google"
# button that works today with zero setup. For live star ratings and
# review snippets shown directly on your site, see GOOGLE_PLACES_API_KEY
# and GOOGLE_PLACE_ID in backend/.env.example instead.
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Your Instagram profile URL, e.g. https://instagram.com/yourbusiness
NEXT_PUBLIC_INSTAGRAM_URL=

# Your live domain, used for canonical URLs, Open Graph tags, and the
# sitemap/robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
