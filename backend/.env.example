PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=tourist_taxi

# Use a long random string in production — e.g. generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# --- Module 4: Payments (Razorpay) ---
# Leave these blank until you have a Razorpay account. The app runs fine
# without them — pay_now bookings will just show a "we'll contact you"
# message instead of a live payment screen. Once you have an account,
# fill these in from Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Percentage of the fare collected as advance for pay_now bookings.
# NOT YET DECIDED — leave blank until finance confirms. The app refuses to
# create real payment orders while this is blank, rather than guessing.
# Example once decided: ADVANCE_PAYMENT_PERCENTAGE=20
ADVANCE_PAYMENT_PERCENTAGE=

# --- Custom Location Pricing (Mapbox) ---
# Leave blank until you have a Mapbox account. The app runs fine without
# it — custom (free-text) location quotes will just show a "not available
# yet, choose from our cities or contact us" message. Get a token at
# mapbox.com > Account > Tokens.
MAPBOX_ACCESS_TOKEN=

# --- Google Reviews (Find Us section on homepage) ---
# Leave blank until you're ready to set up billing on Google Cloud. The
# homepage shows a "Read Reviews on Google" link button instead (set via
# NEXT_PUBLIC_GOOGLE_REVIEWS_URL in frontend/.env.local) until then.
#
# To activate live star ratings + review snippets on your site:
# 1. Go to console.cloud.google.com, create/select a project, enable
#    "Places API", and set up billing (Google requires this even though
#    Places API has a free monthly usage allowance)
# 2. Create an API key under APIs & Services > Credentials
# 3. Find your Place ID: search your business at
#    developers.google.com/maps/documentation/places/web-service/place-id
# 4. Set both values below and restart the server — activates
#    automatically, no code changes needed
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Security: CORS ---
# Your live frontend URL(s), comma-separated if you have more than one
# (e.g. a Vercel preview URL + your custom domain). Requests from any
# other origin are blocked. Leave blank in local development only.
FRONTEND_URL=https://your-domain.example
